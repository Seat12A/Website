---
/*
 * "Has this post been checked?" Starts from a post, not from a fact-check: GET /v1/content/{platform}/{id}/verdict
 * (docs/api-tower.md §4), the same route as the extension. Only verdicts in force come back (an expired or replaced one
 * is absent), and there is no link to the fact-check page. Reached from the search field of /fact-checks when a link
 * is pasted. Not indexed: these pages exist for any post id.
 */
export const prerender = false;

import Page from '../../../layouts/Page.astro';
import PostEmbed from '../../../components/PostEmbed.astro';
import BackLink from '../../../components/fc/BackLink.astro';
import PanelHeader from '../../../components/fc/PanelHeader.astro';
import { Sources } from '../../../components/fc/Sources';
import { SearchBox } from '../../../components/fc/SearchBox';
import { VerdictBadge } from '../../../components/fc/VerdictBadge';
import { Badge } from '../../../components/ui/badge';

import { ApiError, postVerdict, CACHE_NONE, CACHE_NOT_FOUND, CACHE_OK } from '../../../lib/tower.js';
import { CONTEXT_NEED, CONTEXT_TYPES, PLATFORMS, longDate, quote, safeUrl } from '../../../lib/labels.js';

const { platform = '', id = '' } = Astro.params;
const known = platform in PLATFORMS && /^[A-Za-z0-9_.:-]{1,64}$/.test(id) && (platform !== 'x' || /^\d{1,20}$/.test(id));

let post = null, none = !known, failed = false;
if (known) {
  try {
    post = await postVerdict(platform, id);
  } catch (e) {
    if (e instanceof ApiError && (e.code === 'TWR-FCK-013' || e.code === 'TWR-ING-006' || e.code === 'TWR-ING-005' || e.status === 404)) none = true;
    else {
      failed = true;
      console.error('Tower unavailable for a post verdict', e instanceof ApiError ? `${e.status} ${e.code} ${e.requestId}` : e);
    }
  }
}
Astro.response.status = !known ? 404 : failed ? 503 : 200;
Astro.response.headers.set('Cache-Control', failed ? CACHE_NONE : post ? CACHE_OK : CACHE_NOT_FOUND);

const postUrl = post?.url ?? (platform === 'x' && known ? `https://x.com/i/status/${id}` : null);
const claims = post?.claims ?? [];
const h3 = 'text-base font-semibold';
const heading = failed ? 'La vérification de ce post n’est pas disponible pour le moment.'
  : claims.length ? (claims.length > 1 ? `Ce post contient ${claims.length} affirmations vérifiées.` : 'Ce post a été vérifié.')
  : known ? 'Ce post n’a pas (encore) été vérifié par Seat 12A.' : 'Ce lien n’est pas reconnu.';
---
<Page title={`${heading} · Seat 12A`} description="Ce post a-t-il été vérifié par Seat 12A ?" current="/fact-checks" noindex>
  <div class="grid min-h-[calc(100svh-var(--top))] lg:grid-cols-[minmax(0,1fr)_26rem] xl:grid-cols-[minmax(0,1fr)_32rem]">
    <div class="min-w-0 lg:border-r">
      <BackLink label="Un post" />
      <div class="flex flex-col gap-8 px-4 pt-8 pb-16 md:px-6 xl:px-10">
        <header class="flex flex-col gap-3">
          <h1 class="type-title">{heading}</h1>
          {failed && <p class="text-base leading-relaxed text-muted-foreground">Le service qui fournit les vérifications ne répond pas. Réessayez dans quelques minutes.</p>}
          {none && known && <p class="text-base leading-relaxed text-muted-foreground">Seuls les verdicts en vigueur sont affichés{'\u00A0'}: une vérification ancienne ou remplacée par une plus récente n'apparaît pas ici. Vous pouvez aussi chercher l'affirmation avec quelques mots.</p>}
          {!known && <p class="text-base leading-relaxed text-muted-foreground">Collez le lien complet d'un post X, du type https://x.com/compte/status/1234…</p>}
        </header>

        {(none || !known) && <SearchBox label="Chercher une affirmation ou coller un autre lien X" />}

        {claims.map((cl) => {
          const need = CONTEXT_NEED[cl.context_need ?? 'none'];
          const links = (cl.note?.links ?? []).map(safeUrl).filter(Boolean);
          return (
            <article class="flex flex-col gap-6 border-t pt-8">
              <div class="flex flex-col gap-2">
                <p class="text-[13px] text-muted-foreground">Affirmation vérifiée</p>
                <h2 class="text-2xl leading-snug font-semibold tracking-tight text-pretty">{quote(cl.text)}</h2>
              </div>
              <dl class="flex flex-wrap gap-x-10 gap-y-4 rounded-xl bg-muted/60 px-5 py-4">
                <div class="flex flex-col gap-1.5"><dt class="text-[13px] text-muted-foreground">Verdict</dt><dd><VerdictBadge veracity={cl.veracity} size="lg" /></dd></div>
                {need && <div class="flex flex-col gap-1.5"><dt class="text-[13px] text-muted-foreground">Contexte</dt><dd class="flex h-7 items-center text-sm font-medium">{need}</dd></div>}
                {cl.validated_at && <div class="flex flex-col gap-1.5"><dt class="text-[13px] text-muted-foreground">Vérifié le</dt><dd class="flex h-7 items-center text-sm"><time datetime={cl.validated_at}>{longDate(cl.validated_at)}</time></dd></div>}
              </dl>
              {cl.note?.text && <section class="flex flex-col gap-3 border-t pt-6"><h3 class={h3}>Ce qu'il faut savoir</h3><p class="text-[17px] leading-[1.7]">{cl.note.text}</p></section>}
              {cl.note?.machine_translated && <p class="text-xs text-muted-foreground">Traduit automatiquement.</p>}
              {cl.inherited && (
                <p class="text-sm text-muted-foreground">
                  {cl.inherited.rule === 'band' ? 'Le même chiffre a déjà été vérifié dans un autre post.' : 'La même affirmation a déjà été vérifiée dans un autre post.'}
                  {safeUrl(cl.inherited.origin_url) && <> <a class="font-medium text-primary underline-offset-4 hover:underline" href={safeUrl(cl.inherited.origin_url)} rel="noopener noreferrer" target="_blank">Voir le post d'origine</a></>}
                </p>
              )}
              {cl.context_types?.length > 0 && (
                <section class="flex flex-col gap-3 border-t pt-6">
                  <h3 class={h3}>Ce qui manque au post</h3>
                  <ul class="flex flex-wrap gap-2">
                    {cl.context_types.map((t) => <li><Badge variant="secondary" className="h-7 px-3 text-[13px] font-normal">{CONTEXT_TYPES[t] ?? t}</Badge></li>)}
                  </ul>
                </section>
              )}
              {links.length > 0 && (
                <section class="flex flex-col gap-3 border-t pt-6">
                  <h3 class={h3}>Sources <span class="font-normal text-muted-foreground tabular-nums">{links.length}</span></h3>
                  <Sources links={links} />
                </section>
              )}
            </article>
          );
        })}
      </div>
    </div>

    {postUrl && (
      <aside class="min-w-0 max-lg:border-t">
        <PanelHeader title="Le post" />
        <div class="px-4 py-6 md:px-6">
          <PostEmbed url={postUrl} platform={platform} externalId={id} />
        </div>
      </aside>
    )}
  </div>
</Page>
