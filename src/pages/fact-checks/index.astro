---
/*
 * The list of fact-checks. Rendered on the server at each request (cached 5 minutes by Vercel's CDN) from the filters
 * of the address (src/lib/factchecks.js); then the search and the filter chips run in the browser
 * (FactCheckBrowser.tsx, client:load), through /api/fact-checks. The browser never calls Tower.
 *
 * A pasted X link is not a search: it redirects to /post/x/{id}, which asks Tower for the verdicts on that post.
 */
export const prerender = false;

import Page from '../../layouts/Page.astro';
import { FactCheckBrowser } from '../../components/fc/FactCheckBrowser';
import { loadList, readFilters } from '../../lib/factchecks.js';
import { CACHE_NONE, CACHE_OK } from '../../lib/tower.js';
import { xPostId } from '../../lib/labels.js';

const f = readFilters(Astro.url.searchParams);
const postId = xPostId(f.q);
if (postId) return Astro.redirect(`/post/x/${postId}`, 302);

const data = await loadList(f);
Astro.response.headers.set('Cache-Control', data.failed ? CACHE_NONE : CACHE_OK);
if (data.failed) Astro.response.status = 503;

const values = {
  ...(f.veracity.length ? { veracity: f.veracity } : {}),
  ...(f.claimType ? { type: f.claimType } : {}),
  ...(f.juris ? { country: f.juris } : {}),
  ...(f.datePreset ? { datePreset: f.datePreset } : {}),
  ...(f.since ? { since: f.since } : {}),
  ...(f.until ? { until: f.until } : {}),
};
const initial = { q: f.q, values, activeKeys: data.legacy ? [] : f.order, sort: f.sort, page: f.page };
const filtered = Boolean(f.q || f.order.length);
const title = f.page > 1 ? `Les fact-checks, page ${f.page} · Seat 12A` : 'Les fact-checks · Seat 12A';
---
<Page title={title} description="Les posts vérifiés par Seat 12A : un verdict, le contexte qui manque et les sources, pour chacun." current="/fact-checks" noindex={filtered || f.page > 1}>
  <FactCheckBrowser client:load initial={initial} data={data} />
</Page>
