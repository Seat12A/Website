---
/*
 * The page of one fact-check: the claim, the verdict, the context note, what the post leaves out, the detailed sheet,
 * the sources (left), the post (loaded automatically), the facts of the claim and its history (right column). Rendered on the server (cached 5 minutes
 * by Vercel's CDN) from GET /v1/cases/{public_id}/details?lang=fr (docs/api-tower.md §3.2). Unknown or unpublished:
 * a real 404.
 *
 * The claim is always shown between quotation marks: it is what the post says, not what Seat 12A says.
 */
export const prerender = false;

import Page from '../../layouts/Page.astro';
import PostEmbed from '../../components/PostEmbed.astro';
import BackLink from '../../components/fc/BackLink.astro';
import PanelHeader from '../../components/fc/PanelHeader.astro';
import { Sources } from '../../components/fc/Sources';
import { VerdictBadge } from '../../components/fc/VerdictBadge';
import { Alert, AlertDescription, AlertTitle } from '../../components/ui/alert';
import { Badge } from '../../components/ui/badge';
import { Button, buttonVariants } from '../../components/ui/button';
import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from '../../components/ui/empty';
import { CopyIcon, OpenInNewIcon } from '../../components/icons';
import { ApiError, caseDetails, isNotFound, CACHE_NONE, CACHE_NOT_FOUND, CACHE_OK } from '../../lib/tower.js';
import {
  CLAIM_TYPES, CONTEXT_NEED, CONTEXT_TYPES, STATUSES, VERACITY, clock, jurisdiction, language, longDate, period, quote,
  safeUrl, shortDate,
} from '../../lib/labels.js';

const { id = '' } = Astro.params;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

let c = null, missing = false, failed = false;
if (!UUID.test(id)) missing = true;
else {
  try {
    c = await caseDetails(id.toLowerCase());
  } catch (e) {
    if (isNotFound(e)) missing = true;
    else {
      failed = true;
      console.error('Tower unavailable for a fact-check', e instanceof ApiError ? `${e.status} ${e.code} ${e.requestId}` : e);
    }
  }
}
Astro.response.status = missing ? 404 : failed ? 503 : 200;
Astro.response.headers.set('Cache-Control', missing ? CACHE_NOT_FOUND : failed ? CACHE_NONE : CACHE_OK);

const claimText = c ? (c.claim?.text_fr ?? c.claim?.text ?? c.title) : null;
const heading = claimText ? quote(claimText) : c?.kind === 'moderation' ? 'Modération' : 'Vérification';
const verdict = c?.verdict ?? null;
const veracity = verdict?.veracity ?? c?.veracity ?? null;
const need = CONTEXT_NEED[verdict?.context_need ?? c?.context_need ?? 'none'];
const note = c?.note ?? null;
const sources = (note?.links ?? []).map(safeUrl).filter(Boolean);
const sheet = (note?.fact_sheet ?? '').trim().split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const state = verdict?.state ?? c?.verdict_state ?? null;
const juris = c?.claim?.jurisdictions?.length ? c.claim.jurisdictions : (c?.jurisdictions ?? []);
const claimType = c?.claim?.claim_type ?? c?.claim_type ?? null;
const claimLang = c?.claim_lang ?? c?.content?.lang ?? null;
const published = c && !c.legacy ? safeUrl(c.published_url) : null;
const h2 = 'text-[13px] font-medium text-muted-foreground';
const h2Main = 'text-base font-semibold';                       /* the sections of the verdict */
const h2Side = 'text-sm font-semibold';                          /* the sections of the right column */
const label = 'text-[13px] text-muted-foreground';               /* small labels above a value */
const section = 'flex flex-col gap-3 border-b py-8 last:border-b-0';

const facts = c ? [
  claimType && ['Type', CLAIM_TYPES[claimType] ?? claimType],
  c.claim?.subject && ['Sujet', c.claim.subject],
  c.claim?.place && ['Lieu', c.claim.place],
  (c.claim?.period_start || c.claim?.period_end) && ['Période', period(c.claim.period_start, c.claim.period_end)],
  juris.length && ['Pays', juris.map(jurisdiction).join(', ')],
  claimLang && claimLang !== 'fr' && ['Langue du post', language(claimLang)],
].filter(Boolean) : [];

const timeline = (c?.timeline ?? []).filter((t) => t.status in STATUSES);
const v = veracity ? VERACITY[veracity] : null;
const title = missing ? 'Vérification introuvable · Seat 12A'
  : failed ? 'Fact-check · Seat 12A'
  : `${heading}${v ? ` : ${v.label}` : ''} · Seat 12A`;
const description = note?.text ? (note.text.length > 155 ? `${note.text.slice(0, 154)}…` : note.text)
  : 'Une vérification de Seat 12A : le verdict, le contexte qui manque et les sources.';

---
<Page title={title} description={description} current="/fact-checks" noindex={missing || failed}>
  {(missing || failed) && (
    <>
      <BackLink label={missing ? 'Introuvable' : 'Indisponible'} />
      <Empty className="py-24">
        <EmptyHeader>
          <EmptyTitle>{missing ? "Cette vérification n'existe pas." : "Cette vérification n'est pas disponible pour le moment."}</EmptyTitle>
          <EmptyDescription>{missing ? "Le lien est peut-être incomplet, ou la vérification n'est pas encore publiée." : 'Le service qui fournit les vérifications ne répond pas. Réessayez dans quelques minutes.'}</EmptyDescription>
        </EmptyHeader>
      </Empty>
    </>
  )}

  {c && (
    <div class="grid min-h-[calc(100svh-var(--top))] lg:grid-cols-[minmax(0,1fr)_26rem] xl:grid-cols-[minmax(0,1fr)_32rem]">
      <article class="min-w-0 lg:border-r">
        <BackLink label="Vérification">
          <Button variant="ghost" size="sm" className="text-muted-foreground" data-copy>
            <CopyIcon data-icon="inline-start" /><span data-copy-label class="max-sm:hidden">Copier le lien</span>
          </Button>
          {published && (
            <a href={published} rel="noopener noreferrer" target="_blank" class={buttonVariants({ variant: 'ghost', size: 'sm', className: 'text-muted-foreground' })}>
              <span class="max-sm:hidden">Notre publication sur X</span><span class="sm:hidden">Sur X</span><OpenInNewIcon data-icon="inline-end" />
            </a>
          )}
        </BackLink>

        <div class="px-4 pb-16 md:px-6 xl:px-10">
          <header class="flex flex-col gap-6 border-b py-8">
            <div class="flex flex-col gap-2">
              <p class={label}>{c.kind === 'moderation' ? 'Dossier de modération' : 'Affirmation vérifiée'}</p>
              <h1 class:list={[heading.length > 110 ? 'text-2xl leading-snug font-semibold tracking-tight text-pretty' : 'type-title text-pretty']}>{heading}</h1>
            </div>
            <dl class="flex flex-wrap gap-x-10 gap-y-4 rounded-xl bg-muted/60 px-5 py-4">
              {v && <div class="flex flex-col gap-1.5"><dt class={label}>Verdict</dt><dd><VerdictBadge veracity={veracity} size="lg" /></dd></div>}
              {need && <div class="flex flex-col gap-1.5"><dt class={label}>Contexte</dt><dd class="flex h-7 items-center text-sm font-medium">{need}</dd></div>}
              {verdict?.validated_at && <div class="flex flex-col gap-1.5"><dt class={label}>Vérifié le</dt><dd class="flex h-7 items-center text-sm"><time datetime={verdict.validated_at}>{longDate(verdict.validated_at)}</time></dd></div>}
              {c.published_at && <div class="flex flex-col gap-1.5"><dt class={label}>Publié le</dt><dd class="flex h-7 items-center text-sm"><time datetime={c.published_at}>{longDate(c.published_at)}</time></dd></div>}
              {!verdict?.validated_at && !c.published_at && c.updated_at && <div class="flex flex-col gap-1.5"><dt class={label}>Mis à jour le</dt><dd class="flex h-7 items-center text-sm"><time datetime={c.updated_at}>{longDate(c.updated_at)}</time></dd></div>}
            </dl>
          </header>

          {state === 'expired' && (
            <Alert className="mt-8">
              <AlertTitle>Vérification susceptible d'être dépassée</AlertTitle>
              <AlertDescription>Elle date du {shortDate(verdict?.validated_at ?? c.published_at)}{'\u00A0'}: la situation a pu changer depuis.</AlertDescription>
            </Alert>
          )}
          {state === 'superseded' && (
            <Alert className="mt-8">
              <AlertTitle>Ce verdict a été mis à jour</AlertTitle>
              <AlertDescription>Une vérification plus récente le remplace.</AlertDescription>
            </Alert>
          )}

          {c.legacy && (
            <p class={section}>Le verdict, le contexte et les sources de cette vérification seront bientôt affichés ici.{safeUrl(c.published_url) && <> En attendant, <a class="font-medium text-primary underline-offset-4 hover:underline" href={safeUrl(c.published_url)} rel="noopener noreferrer" target="_blank">elle est publiée sur X</a>.</>}</p>
          )}
          {c.kind === 'moderation' && !c.legacy && <p class={section}>Ce dossier concerne une décision de modération{'\u00A0'}: il n'a pas de verdict.</p>}

          {note?.text && (
            <section class={section}>
              <h2 class={h2Main}>Ce qu'il faut savoir</h2>
              <p class="text-[17px] leading-[1.7]">{note.text}</p>
              {note.machine_translated && <p class="text-xs text-muted-foreground">Traduit automatiquement.</p>}
            </section>
          )}
          {!note && verdict && <p class:list={[section, 'text-sm text-muted-foreground']}>La note de contexte de cette vérification n'est plus affichée{'\u00A0'}: seul le verdict reste.</p>}

          {verdict?.context_types?.length > 0 && (
            <section class={section}>
              <h2 class={h2Main}>Ce qui manque au post</h2>
              <ul class="flex flex-wrap gap-2">
                {verdict.context_types.map((t) => <li><Badge variant="secondary" className="h-7 px-3 text-[13px] font-normal">{CONTEXT_TYPES[t] ?? t}</Badge></li>)}
              </ul>
            </section>
          )}

          {sheet.length > 0 && (
            <section class={section}>
              <h2 class={h2Main}>En savoir plus</h2>
              {sheet.map((p) => <p class="text-base leading-7 whitespace-pre-line">{p}</p>)}
            </section>
          )}

          {sources.length > 0 && (
            <section class={section}>
              <h2 class={h2Main}>Sources <span class="font-normal text-muted-foreground tabular-nums">{sources.length}</span></h2>
              <Sources links={sources} />
            </section>
          )}
        </div>
      </article>

      <aside class="min-w-0 max-lg:border-t">
        {(c.content?.url || c.url) && (
          <section>
            <PanelHeader title="Le post vérifié" note={c.posts_count > 1 ? `L'affirmation circule dans ${c.posts_count} posts` : undefined} />
            <div class="px-4 py-6 md:px-6">
              <PostEmbed url={c.content?.url ?? c.url} platform={c.content?.platform ?? c.platform} externalId={c.content?.external_id ?? c.external_id ?? c.x_post_id} />
            </div>
          </section>
        )}

        {facts.length > 0 && (
          <section class="border-t px-4 py-6 md:px-6">
            <h2 class={h2Side}>Détails de l'affirmation</h2>
            <dl class="mt-3 grid grid-cols-[7rem_minmax(0,1fr)] gap-x-4 text-sm">
              {facts.map(([k, val]) => <><dt class="py-1.5 text-muted-foreground">{k}</dt><dd class="py-1.5 [overflow-wrap:anywhere]">{val}</dd></>)}
            </dl>
          </section>
        )}

        {timeline.length > 0 && (
          <section class="border-t px-4 py-6 md:px-6">
            <h2 class={h2Side}>Historique</h2>
            <ol class="mt-4 ml-1 flex flex-col gap-3 border-l pl-4 text-sm">
              {timeline.map((t, i) => (
                <li class="relative flex items-baseline justify-between gap-3">
                  <span class:list={['absolute top-1.5 -left-[21px] size-2.5 rounded-full ring-4 ring-background', i === timeline.length - 1 ? 'bg-primary' : 'bg-muted-foreground/40']} aria-hidden="true"></span>
                  <span>{STATUSES[t.status]}</span>
                  <time class="text-[13px] text-muted-foreground tabular-nums" datetime={t.at}>{shortDate(t.at)} à {clock(t.at)}</time>
                </li>
              ))}
            </ol>
          </section>
        )}
      </aside>
    </div>
  )}

  <script>
    /* "Copier le lien": the address of this page, then "Lien copié" for two seconds */
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
      const label = b.querySelector('[data-copy-label]');
      try { await navigator.clipboard.writeText(location.href); if (label) label.textContent = 'Lien copié'; }
      catch { if (label) label.textContent = 'Copie impossible'; }
      setTimeout(() => { if (label) label.textContent = 'Copier le lien'; }, 2000);
    }));
  </script>
</Page>
