---
/*
 * The page of one fact-check: the claim, the verdict, the context note, what the post leaves out, the detailed sheet,
 * the sources, the post (on demand), the facts of the claim and its history. Rendered on the server (cached 5 minutes
 * by Vercel's CDN) from GET /v1/cases/{public_id}/details?lang=fr (docs/api-tower.md §3.2). Unknown or unpublished:
 * a real 404.
 *
 * The claim is always shown between quotation marks: it is what the post says, not what Seat 12A says.
 */
export const prerender = false;

import Page from '../../layouts/Page.astro';
import PostEmbed from '../../components/PostEmbed.astro';
import BackLink from '../../components/fc/BackLink.astro';
import { Sources } from '../../components/fc/Sources';
import { VerdictBadge } from '../../components/fc/VerdictBadge';
import { Alert, AlertDescription, AlertTitle } from '../../components/ui/alert';
import { Badge } from '../../components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from '../../components/ui/empty';
import { Separator } from '../../components/ui/separator';
import { ApiError, caseDetails, isNotFound, CACHE_NONE, CACHE_NOT_FOUND, CACHE_OK } from '../../lib/tower.js';
import {
  CLAIM_TYPES, CONTEXT_NEED, CONTEXT_TYPES, STATUSES, VERACITY, clock, jurisdiction, language, longDate, period, quote,
  safeUrl, shortDate,
} from '../../lib/labels.js';

const { id = '' } = Astro.params;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

let c = null, missing = false, failed = false;
if (!UUID.test(id)) missing = true;
else {
  try {
    c = await caseDetails(id.toLowerCase());
  } catch (e) {
    if (isNotFound(e)) missing = true;
    else {
      failed = true;
      console.error('Tower unavailable for a fact-check', e instanceof ApiError ? `${e.status} ${e.code} ${e.requestId}` : e);
    }
  }
}
Astro.response.status = missing ? 404 : failed ? 503 : 200;
Astro.response.headers.set('Cache-Control', missing ? CACHE_NOT_FOUND : failed ? CACHE_NONE : CACHE_OK);

const claimText = c ? (c.claim?.text_fr ?? c.claim?.text ?? c.title) : null;
const heading = claimText ? quote(claimText) : c?.kind === 'moderation' ? 'Modération' : 'Vérification';
const verdict = c?.verdict ?? null;
const veracity = verdict?.veracity ?? c?.veracity ?? null;
const need = CONTEXT_NEED[verdict?.context_need ?? c?.context_need ?? 'none'];
const note = c?.note ?? null;
const sources = (note?.links ?? []).map(safeUrl).filter(Boolean);
const sheet = (note?.fact_sheet ?? '').trim().split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const state = verdict?.state ?? c?.verdict_state ?? null;
const juris = c?.claim?.jurisdictions?.length ? c.claim.jurisdictions : (c?.jurisdictions ?? []);
const claimType = c?.claim?.claim_type ?? c?.claim_type ?? null;
const claimLang = c?.claim_lang ?? c?.content?.lang ?? null;
const published = c && !c.legacy ? safeUrl(c.published_url) : null;

const facts = c ? [
  claimType && ['Type', CLAIM_TYPES[claimType] ?? claimType],
  c.claim?.subject && ['Sujet', c.claim.subject],
  c.claim?.place && ['Lieu', c.claim.place],
  (c.claim?.period_start || c.claim?.period_end) && ['Période', period(c.claim.period_start, c.claim.period_end)],
  juris.length && ['Pays', juris.map(jurisdiction).join(', ')],
  claimLang && claimLang !== 'fr' && ['Langue du post', language(claimLang)],
].filter(Boolean) : [];

const timeline = (c?.timeline ?? []).filter((t) => t.status in STATUSES);
const v = veracity ? VERACITY[veracity] : null;
const title = missing ? 'Vérification introuvable · Seat 12A'
  : failed ? 'Fact-check · Seat 12A'
  : `${heading}${v ? ` : ${v.label}` : ''} · Seat 12A`;
const description = note?.text ? (note.text.length > 155 ? `${note.text.slice(0, 154)}…` : note.text)
  : 'Une vérification de Seat 12A : le verdict, le contexte qui manque et les sources.';

---
<Page title={title} description={description} current="/fact-checks" noindex={missing || failed}>
  <BackLink />

  {(missing || failed) && (
    <Empty className="rounded-3xl border border-dashed py-16">
      <EmptyHeader>
        <EmptyTitle className="type-title">{missing ? "Cette vérification n'existe pas." : "Cette vérification n'est pas disponible pour le moment."}</EmptyTitle>
        <EmptyDescription>{missing ? "Le lien est peut-être incomplet, ou la vérification n'est pas encore publiée." : 'Le service qui fournit les vérifications ne répond pas. Réessayez dans quelques minutes.'}</EmptyDescription>
      </EmptyHeader>
    </Empty>
  )}

  {c && (
    <article class="flex flex-col gap-6">
      <header class="flex flex-col gap-4 px-1">
        {(v || need) && (
          <div class="flex flex-wrap items-center gap-2">
            {v && <VerdictBadge veracity={veracity} size="lg" />}
            {need && <Badge variant="outline" className="h-8 px-3.5 text-sm font-normal text-muted-foreground">{need}</Badge>}
          </div>
        )}
        <h1 class="type-title">{heading}</h1>
        <p class="text-sm text-muted-foreground">
          {verdict?.validated_at && <>Vérifié le <time datetime={verdict.validated_at}>{longDate(verdict.validated_at)}</time></>}
          {verdict?.validated_at && c.published_at && ' · '}
          {c.published_at && <>{verdict?.validated_at ? 'publié' : 'Publié'} le <time datetime={c.published_at}>{longDate(c.published_at)}</time></>}
          {!verdict?.validated_at && !c.published_at && c.updated_at && <>Mis à jour le <time datetime={c.updated_at}>{longDate(c.updated_at)}</time></>}
        </p>
      </header>

      {state === 'expired' && (
        <Alert>
          <AlertTitle>Vérification susceptible d'être dépassée</AlertTitle>
          <AlertDescription>Elle date du {shortDate(verdict?.validated_at ?? c.published_at)} : la situation a pu changer depuis.</AlertDescription>
        </Alert>
      )}
      {state === 'superseded' && (
        <Alert>
          <AlertTitle>Ce verdict a été mis à jour</AlertTitle>
          <AlertDescription>Une vérification plus récente le remplace.</AlertDescription>
        </Alert>
      )}

      {c.legacy && (
        <Card>
          <CardHeader>
            <CardTitle>Le détail arrive bientôt</CardTitle>
            <CardDescription>Le verdict, le contexte et les sources de cette vérification seront bientôt affichés ici.</CardDescription>
          </CardHeader>
          {safeUrl(c.published_url) && <CardContent><a class="text-sm font-medium text-primary underline-offset-4 hover:underline" href={safeUrl(c.published_url)} rel="noopener noreferrer" target="_blank">Voir la publication sur X</a></CardContent>}
        </Card>
      )}
      {c.kind === 'moderation' && !c.legacy && <p class="px-1 text-base leading-relaxed">Ce dossier concerne une décision de modération : il n'a pas de verdict.</p>}

      {(note?.text || verdict?.context_types?.length > 0 || sheet.length > 0) && (
        <Card>
          {note?.text && (
            <CardHeader>
              <CardTitle>Ce qu'il faut savoir</CardTitle>
            </CardHeader>
          )}
          {note?.text && (
            <CardContent className="flex flex-col gap-2">
              <p class="text-base leading-relaxed">{note.text}</p>
              {note.machine_translated && <p class="text-xs text-muted-foreground">Traduit automatiquement.</p>}
            </CardContent>
          )}
          {verdict?.context_types?.length > 0 && (
            <CardContent className="flex flex-col gap-3">
              <h2 class="text-sm font-medium text-muted-foreground">Ce qui manque au post</h2>
              <ul class="flex flex-wrap gap-2">
                {verdict.context_types.map((t) => <li><Badge variant="secondary" className="h-7 px-3 text-[13px] font-normal">{CONTEXT_TYPES[t] ?? t}</Badge></li>)}
              </ul>
            </CardContent>
          )}
          {sheet.length > 0 && (
            <CardContent className="flex flex-col gap-3">
              <Separator />
              <h2 class="pt-3 text-sm font-medium text-muted-foreground">En savoir plus</h2>
              {sheet.map((p) => <p class="leading-relaxed whitespace-pre-line text-muted-foreground">{p}</p>)}
            </CardContent>
          )}
        </Card>
      )}
      {!note && verdict && <p class="px-1 text-sm text-muted-foreground">La note de contexte de cette vérification n'est plus affichée : seul le verdict reste.</p>}

      {sources.length > 0 && <Sources links={sources} />}

      {(c.content?.url || c.url) && (
        <Card>
          <CardHeader>
            <CardTitle>Le post vérifié</CardTitle>
            {c.posts_count > 1 && <CardDescription>Cette affirmation circule dans {c.posts_count} posts.</CardDescription>}
          </CardHeader>
          <CardContent>
            <PostEmbed url={c.content?.url ?? c.url} platform={c.content?.platform ?? c.platform} externalId={c.content?.external_id ?? c.external_id ?? c.x_post_id} />
          </CardContent>
        </Card>
      )}

      {(facts.length > 0 || published || timeline.length > 0) && (
        <div class="grid gap-6 md:grid-cols-2">
          {(facts.length > 0 || published) && (
            <Card size="sm">
              <CardHeader><CardTitle>L'affirmation</CardTitle></CardHeader>
              <CardContent>
                <dl class="grid grid-cols-[max-content_minmax(0,1fr)] gap-x-5 gap-y-2.5 text-sm">
                  {facts.map(([k, val]) => <><dt class="text-muted-foreground">{k}</dt><dd class="[overflow-wrap:anywhere]">{val}</dd></>)}
                  {published && <><dt class="text-muted-foreground">Sur X</dt><dd><a class="font-medium text-primary underline-offset-4 hover:underline" href={published} rel="noopener noreferrer" target="_blank">Notre publication</a></dd></>}
                </dl>
              </CardContent>
            </Card>
          )}
          {timeline.length > 0 && (
            <Card size="sm">
              <CardHeader><CardTitle>Historique</CardTitle></CardHeader>
              <CardContent>
                <ol class="flex flex-col gap-2.5 text-sm">
                  {timeline.map((t, i) => (
                    <li class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3">
                      <span class:list={['size-2 rounded-full', i === timeline.length - 1 ? 'bg-primary' : 'bg-border']} aria-hidden="true"></span>
                      <span>{STATUSES[t.status]}</span>
                      <time class="text-xs text-muted-foreground tabular-nums" datetime={t.at}>{shortDate(t.at)} {clock(t.at)}</time>
                    </li>
                  ))}
                </ol>
              </CardContent>
            </Card>
          )}
        </div>
      )}
    </article>
  )}
</Page>
