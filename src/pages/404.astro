---
/*
 * Not found. A plain night-blue page (not the home page's scene: Jules, 25/11/2026), the home page's navigation bar,
 * and alone in the middle an airliner that came down nose first, rendered as pixel art (scripts/lost/plane.js).
 * One sentence, two ways out. Without JavaScript: the page and the text.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import '../styles/site.css';
---
<Base title="Page introuvable · Seat 12A" description="Cette page n'existe pas." noindex>
  <Nav />
  <main class="lost">
    <canvas id="plane" aria-hidden="true"></canvas>
    <div class="text">
      <h1>Cette porte d'embarquement n'existe pas.</h1>
      <p>La page a peut-être changé d'adresse, ou n'a jamais existé.</p>
      <div class="ctas">
        <a class="btn" href="/">Retour à l'accueil</a>
        <a class="link" href="/fact-checks">Voir les fact-checks</a>
      </div>
    </div>
  </main>

  <script>
    import { createPlane } from '../scripts/lost/plane.js';
    import { cellSize } from '../scripts/home/renderer.js';
    /* the plane on the same cell size as the home page's scene; about 230 cells wide on a computer, less on a phone */
    const canvas = document.getElementById('plane') as HTMLCanvasElement;
    const plane = createPlane(canvas);
    let last = '';
    function draw() {
      const { css } = cellSize();
      const cols = Math.min(230, Math.floor((innerWidth - 32) / css), Math.floor(innerHeight * .5 / css / .72));
      const key = `${cols}x${css}`;
      if (key !== last) { last = key; plane.render(cols, css); }
    }
    draw();
    let timer = 0;
    addEventListener('resize', () => { clearTimeout(timer); timer = window.setTimeout(draw, 200); });
    /* links to pages that do not exist yet do nothing */
    document.querySelectorAll('[data-soon]').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
  </script>
</Base>

<style is:global>
  body { margin: 0; background: #0B1030; color: var(--white); font: 14px/1.4 var(--sans); -webkit-font-smoothing: antialiased; }
</style>
<style>
  .lost {
    min-height: 100svh; box-sizing: border-box; padding: 96px 16px 48px;
    display: grid; place-content: center; justify-items: center; gap: 28px; text-align: center;
  }
  #plane { image-rendering: pixelated; max-width: 100%; }
  .text { display: grid; justify-items: center; gap: 18px; max-width: 640px; }
  h1 { margin: 0; font-weight: 500; font-size: clamp(30px, 4.2vw, 54px); line-height: 1.02; letter-spacing: -.045em; text-wrap: balance; }
  p { margin: 0; font-size: 17px; line-height: 1.55; color: var(--soft); text-wrap: pretty; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 24px; margin-top: 4px; }
</style>
