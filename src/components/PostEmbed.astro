---
/*
 * The verified post. Tower never gives its text or its author: the page shows it through the platform's official
 * embed. For X, the embed loads automatically (Jules, 25/11/2026): widgets.js comes from X and can set cookies, which
 * is said under the post. Until it has loaded (or if it is blocked), a plain link. Other platforms: a link.
 */
import { buttonVariants } from './ui/button';
import { OpenInNewIcon } from './icons';
import { PLATFORMS, safeUrl } from '../lib/labels.js';

interface Props {
  url: string | null | undefined;
  platform?: string | null;
  externalId?: string | null;
}
const { url, platform, externalId } = Astro.props;
const link = safeUrl(url);
const name = PLATFORMS[platform ?? ''] ?? 'la plateforme';
const xId = platform === 'x' && /^\d{1,20}$/.test(externalId ?? '') ? externalId : null;
---
{link && (
  <div class="post flex flex-col gap-2">
    {xId ? (
      <blockquote class="twitter-tweet m-0 flex min-h-32 items-center justify-center rounded-2xl bg-muted/60 p-4 text-sm text-muted-foreground" data-dnt="true" data-lang="fr" data-conversation="none">
        <a href={`https://twitter.com/i/status/${xId}`} data-fallback>Chargement du post…</a>
      </blockquote>
    ) : (
      <a href={link} rel="noopener noreferrer" target="_blank" class={buttonVariants({ variant: 'outline', className: 'self-start' })}>Ouvrir sur {name}<OpenInNewIcon data-icon="inline-end" /></a>
    )}
    {xId && (
      <p class="text-xs text-muted-foreground">
        Affiché par X, qui peut déposer des cookies. <a href={link} rel="noopener noreferrer" target="_blank" class="font-medium text-foreground underline-offset-4 hover:underline">Ouvrir sur X</a>
      </p>
    )}
  </div>
)}

<script>
  /* Official X embed, in the colours of the visitor's theme; widgets.js is loaded once for the whole page. */
  const quotes = document.querySelectorAll<HTMLElement>('.post .twitter-tweet');
  if (quotes.length) {
    const dark = matchMedia('(prefers-color-scheme: dark)').matches;
    quotes.forEach((q) => { q.dataset.theme = dark ? 'dark' : 'light'; });
    const s = document.createElement('script');
    s.src = 'https://platform.twitter.com/widgets.js';
    s.async = true;
    s.onerror = () => quotes.forEach((q) => { const a = q.querySelector('[data-fallback]'); if (a) a.textContent = 'Le post n’a pas pu être chargé. Ouvrir sur X'; });
    document.head.append(s);
  }
</script>
