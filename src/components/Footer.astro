---
/*
 * Footer of the whole site (dark, with a dithered edge; styles in styles/chrome.css). Links: lib/links.js. On the home
 * page the last link takes off again (back to the top of the flight, main.js); elsewhere it goes back to the home page.
 */
import { ABOUT, FOOTER } from '../lib/links.js';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="foot" id="foot">
  <div class="foot-in">
    <div class="foot-brand">
      <p>{ABOUT}</p>
    </div>
    <nav class="foot-cols" aria-label="Pied de page">
      {FOOTER.map((col) => (
        <div><h2>{col.title}</h2>{col.links.map((l) => l.href
          ? <a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>
          : <a href="#" data-soon>{l.label}</a>)}</div>
      ))}
    </nav>
    <div class="foot-base">
      <span>© {year} Seat 12A</span>
      {home ? <button class="link" id="takeoff" type="button">Redécoller</button> : <a class="link" href="/">Retour à l'accueil</a>}
    </div>
  </div>
</footer>
