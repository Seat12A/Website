---
/*
 * The navigation bar of the whole site (one component, styles in styles/chrome.css). On the home page it floats over
 * the flight and turns solid when you scroll (main.js); on the other pages it is solid from the start (`solid`), since
 * there is no sky behind it. Links marked data-soon point to pages that do not exist yet: a click does nothing.
 */
import Logo from './Logo.astro';
import { NAV } from '../lib/links.js';

interface Props { solid?: boolean; current?: string }
const { solid = false, current } = Astro.props;
---
<nav class:list={['nav', { solid }]} id="nav" aria-label="Navigation principale">
  <a class="brand" href="/" id="home" aria-label="Seat 12A, accueil"><Logo /></a>
  <div class="nav-links">
    {NAV.map((l) => l.href
      ? <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>
      : <a href="#" data-soon>{l.label}</a>)}
  </div>
  <a class="btn small" href="#" data-soon>Ajouter l'extension</a>
</nav>
