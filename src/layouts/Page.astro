---
/*
 * Shell of the pages other than the home page. The navigation bar and the footer are the home page's own components
 * (Nav.astro, Footer.astro, styles/chrome.css): the site reads as one. In between, shadcn/ui (radix-maia, blue theme),
 * light by default and dark when the computer is (global.css).
 */
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  current?: string;
  wide?: boolean;
}
const { title, description, noindex = false, current, wide = false } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <slot name="head" slot="head" />
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:text-primary-foreground">Aller au contenu</a>

  <Nav solid current={current} />

  <main id="main" class:list={['mx-auto min-h-[70vh] px-4 pt-28 pb-32 md:pt-36', wide ? 'max-w-5xl' : 'max-w-3xl']}>
    <slot />
  </main>

  <Footer />

  <script>
    /* links to pages that do not exist yet do nothing */
    document.querySelectorAll('[data-soon]').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
  </script>
</Base>
